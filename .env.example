# Copy to .env and adjust. Never commit real secrets.

# Server port (Hugging Face Spaces expects 7860)
PORT=7860

# Optional: protect POST /reload-model (send header X-Admin-Token)
MCPGUARD_ADMIN_TOKEN=

# Optional: any SQLAlchemy URL (defaults to SQLite under artifacts/)
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/mcpguard

# Logging
MCPGUARD_LOG_JSON=0
MCPGUARD_LOG_LEVEL=INFO

# Optional: Hugging Face token for faster model downloads during training
# HF_TOKEN=
